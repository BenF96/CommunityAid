<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Dashboard</h1>
    <p class="muted small"><time data-live-date datetime="<%= new Date().toISOString() %>"><%= dateTime(new Date()) %></time></p>
  </div>
  <div class="actions">
    <a href="/resources/new" class="btn btn-ghost">Add resource</a>
    <a href="/requests/export.csv" class="btn btn-ghost"><%- icon('download') %> Export CSV</a>
  </div>
</div>

<% if (d.status.total === 0 && d.resources.food + d.resources.financial === 0) { %>
  <section class="panel note">
    <p><strong>Nothing here yet.</strong> Add the food banks and aid programs you refer people to, then log requests as they come in.</p>
    <div class="actions">
      <a href="/resources/new" class="btn btn-small">Add a resource</a>
      <a href="/requests/new" class="btn btn-small btn-ghost">Log a request</a>
    </div>
  </section>
<% } %>

<% var avgDays = d.avgDaysToFulfil == null ? '–' : d.avgDaysToFulfil < 1 ? '< 1 day' : d.avgDaysToFulfil.toFixed(1) + ' days'; %>
<section class="figures" aria-label="Key figures">
  <a class="figure" href="/requests?status=open">
    <span class="figure-label">Open requests</span>
    <span class="figure-value"><%= d.status.open %></span>
    <span class="figure-sub"><%= d.status.pending %> pending, <%= d.status.inProgress %> in progress</span>
  </a>
  <a class="figure<%= d.urgency.high ? ' is-alert' : '' %>" href="/requests?status=open&urgency=3">
    <span class="figure-label">Urgent &amp; open</span>
    <span class="figure-value"><%= d.urgency.high %></span>
    <span class="figure-sub">High urgency, not fulfilled</span>
  </a>
  <div class="figure">
    <span class="figure-label">People waiting</span>
    <span class="figure-value"><%= d.people.waiting %></span>
    <span class="figure-sub">Household members, open requests</span>
  </div>
  <a class="figure" href="/requests?status=fulfilled">
    <span class="figure-label">People helped</span>
    <span class="figure-value"><%= d.people.helped %></span>
    <span class="figure-sub"><%= d.status.fulfilled %> fulfilled request<%= d.status.fulfilled === 1 ? '' : 's' %></span>
  </a>
  <a class="figure" href="/requests?status=open&aidType=financial">
    <span class="figure-label">Financial aid requested</span>
    <span class="figure-value"><%= money(d.amount.open) %></span>
    <span class="figure-sub">Open financial requests</span>
  </a>
  <div class="figure">
    <span class="figure-label">Financial aid fulfilled</span>
    <span class="figure-value"><%= money(d.amount.fulfilled) %></span>
    <span class="figure-sub">Covered so far</span>
  </div>
  <div class="figure">
    <span class="figure-label">Avg. time to fulfil</span>
    <span class="figure-value"><%= avgDays %></span>
    <span class="figure-sub">Logged to fulfilled</span>
  </div>
  <a class="figure" href="/resources?state=active">
    <span class="figure-label">Active resources</span>
    <span class="figure-value"><%= d.resources.active %></span>
    <span class="figure-sub"><%= d.resources.food %> food, <%= d.resources.financial %> financial<%= d.resources.inactive ? ', ' + d.resources.inactive + ' inactive' : '' %></span>
  </a>
</section>

<div class="grid-2">
  <!-- Pipeline -->
  <section class="panel">
    <div class="panel-head">
      <h2>Request pipeline</h2>
      <span class="muted small"><%= d.status.total %> total</span>
    </div>
    <% if (d.status.total) { %>
      <div class="stacked" role="img" aria-label="<%= d.status.pending %> pending, <%= d.status.inProgress %> in progress, <%= d.status.fulfilled %> fulfilled">
        <span class="seg seg-pending" style="width: <%= pct(d.status.pending, d.status.total) %>%"></span>
        <span class="seg seg-progress" style="width: <%= pct(d.status.inProgress, d.status.total) %>%"></span>
        <span class="seg seg-fulfilled" style="width: <%= pct(d.status.fulfilled, d.status.total) %>%"></span>
      </div>
      <ul class="legend">
        <li><a href="/requests?status=pending"><span class="dot seg-pending"></span>Pending <strong><%= d.status.pending %></strong> <span class="muted">(<%= pct(d.status.pending, d.status.total) %>%)</span></a></li>
        <li><a href="/requests?status=in-progress"><span class="dot seg-progress"></span>In progress <strong><%= d.status.inProgress %></strong> <span class="muted">(<%= pct(d.status.inProgress, d.status.total) %>%)</span></a></li>
        <li><a href="/requests?status=fulfilled"><span class="dot seg-fulfilled"></span>Fulfilled <strong><%= d.status.fulfilled %></strong> <span class="muted">(<%= pct(d.status.fulfilled, d.status.total) %>%)</span></a></li>
      </ul>
    <% } else { %>
      <p class="muted">No requests yet.</p>
    <% } %>

    <h3 class="subhead">Open requests by urgency</h3>
    <% var urgMax = Math.max(1, d.urgency.high, d.urgency.medium, d.urgency.low); %>
    <div class="hbars">
      <% [['High', d.urgency.high, 'u3', 3], ['Medium', d.urgency.medium, 'u2', 2], ['Low', d.urgency.low, 'u1', 1]].forEach(function (u) { %>
        <a class="hbar" href="/requests?status=open&urgency=<%= u[3] %>">
          <span class="hbar-label"><%= u[0] %></span>
          <span class="hbar-track"><span class="hbar-fill fill-<%= u[2] %>" style="width: <%= pct(u[1], urgMax) %>%"></span></span>
          <span class="hbar-value"><%= u[1] %></span>
        </a>
      <% }) %>
    </div>
  </section>

  <!-- By type -->
  <section class="panel">
    <div class="panel-head">
      <h2>By type of aid</h2>
    </div>
    <div class="type-cards">
      <% [['food', 'Food', 'food'], ['financial', 'Financial', 'money']].forEach(function (t) { var s = d.byType[t[0]]; %>
        <div class="type-card type-<%= t[0] %>">
          <div class="type-card-head"><strong><%= t[1] %></strong></div>
          <div class="type-card-value"><%= s.total %> <small>requests</small></div>
          <div class="progress" title="<%= pct(s.fulfilled, s.total) %>% fulfilled">
            <span style="width: <%= pct(s.fulfilled, s.total) %>%"></span>
          </div>
          <div class="type-card-meta">
            <a href="/requests?aidType=<%= t[0] %>&status=open"><%= s.open %> open</a>
            <span><%= pct(s.fulfilled, s.total) %>% fulfilled</span>
          </div>
        </div>
      <% }) %>
    </div>

    <h3 class="subhead">New requests &mdash; last <%= d.daily.length %> days <span class="muted small">(<%= d.dailyTotal %> total)</span></h3>
    <div class="columns" role="img" aria-label="Requests submitted per day over the last <%= d.daily.length %> days">
      <% d.daily.forEach(function (day, i) { %>
        <div class="col" title="<%= date(day.date) %>: <%= day.n %> request<%= day.n === 1 ? '' : 's' %>">
          <span class="col-value"><%= day.n || '' %></span>
          <span class="col-bar" style="height: <%= Math.max(day.n ? 6 : 2, pct(day.n, d.dailyMax)) %>%"></span>
          <span class="col-label"><%= (i % 2 === 0 || i === d.daily.length - 1) ? day.date.toLocaleDateString('en-US', { month: 'numeric', day: 'numeric', timeZone: 'UTC' }) : '' %></span>
        </div>
      <% }) %>
    </div>
  </section>
</div>

<div class="grid-2 grid-wide-left">
  <!-- Needs attention -->
  <section class="panel">
    <div class="panel-head">
      <h2>Needs attention</h2>
      <a href="/requests?status=open" class="small">All open requests</a>
    </div>
    <% if (d.needsAttention.length === 0) { %>
      <p class="muted">No open requests.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table responsive">
          <thead><tr><th>Requester</th><th>Need</th><th>Urgency</th><th>Status</th><th>Waiting</th></tr></thead>
          <tbody>
          <% d.needsAttention.forEach(function (r) { %>
            <tr>
              <td data-label="Requester">
                <a href="/requests/<%= r._id %>" class="strong"><%= r.fullName %></a>
                <div class="muted small mono"><%= r.refCode %></div>
              </td>
              <td data-label="Need">
                <span class="tag tag-<%= r.aidType %>"><%= r.aidType %></span>
                <% if (r.amountNeeded != null) { %><span class="small"><%= money(r.amountNeeded) %></span><% } %>
                <div class="muted small"><%= truncate(r.description, 60) %></div>
              </td>
              <td data-label="Urgency"><span class="urgency u<%= r.urgency %>"><%= r.urgencyLabel %></span></td>
              <td data-label="Status"><span class="status s-<%= r.status %>"><%= statusLabel(r.status) %></span></td>
              <td data-label="Waiting"><strong><%= r.daysOpen %></strong> day<%= r.daysOpen === 1 ? '' : 's' %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <!-- Activity -->
  <section class="panel">
    <div class="panel-head"><h2>Recent activity</h2></div>
    <% if (d.activity.length === 0) { %>
      <p class="muted">No activity yet.</p>
    <% } else { %>
      <ol class="timeline compact">
        <% d.activity.forEach(function (a) { %>
          <li class="tl-<%= a.history.action %>">
            <span class="tl-dot"></span>
            <div>
              <a href="/requests/<%= a._id %>"><%= a.fullName %></a>
              <span class="muted small mono"><%= a.ref || '' %></span>
              <div class="small"><%= a.history.detail %></div>
              <div class="muted small"><%= timeAgo(a.history.at) %></div>
            </div>
          </li>
        <% }) %>
      </ol>
    <% } %>
  </section>
</div>

<!-- Resource usage -->
<section class="panel">
  <div class="panel-head">
    <h2>Most-used resources</h2>
    <a href="/resources" class="small">All resources</a>
  </div>
  <% if (d.topResources.length === 0) { %>
    <p class="muted">No requests have been assigned to a resource yet.</p>
  <% } else { %>
    <% var topMax = d.topResources[0].total; %>
    <div class="hbars">
      <% d.topResources.forEach(function (t) { %>
        <a class="hbar wide" href="/resources/<%= t._id %>">
          <span class="hbar-label"><span class="tag tag-<%= t.resource.category %>"><%= t.resource.category %></span> <%= t.resource.name %></span>
          <span class="hbar-track"><span class="hbar-fill fill-brand" style="width: <%= pct(t.total, topMax) %>%"></span></span>
          <span class="hbar-value"><%= t.total %> <span class="muted small">(<%= t.open %> open)</span></span>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
